# Python reads process environment; this file is documentation, not auto-loaded.
VIDEOCODING_ALLOW_LIVE_OPERATIONS=0
VIDEOCODING_ENABLE_LOCAL_BILLING=0
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
# Set to a NEW isolated database, never the former operator's live file.
# VIDEOCODING_DB=/absolute/path/to/private/outreach.sqlite
PRODUCT_OUTREACH_API_ORIGIN=
PRODUCT_OUTREACH_AUTOMATION_TOKEN=
# Optional, do not assume the old SSH tunnel exists.
