<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.videocoding.outreach</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/OPERATOR/.videocoding-outreach-runtime/scripts/outreach_scheduler.py</string>
    <string>--scheduled</string>
    <string>--limit</string>
    <string>50</string>
    <string>--min-interval-seconds</string>
    <string>45</string>
    <string>--max-interval-seconds</string>
    <string>60</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/OPERATOR/.videocoding-outreach-runtime</string>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/OPERATOR/.videocoding-outreach-runtime/logs/outreach-scheduler.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/OPERATOR/.videocoding-outreach-runtime/logs/outreach-scheduler.error.log</string>
  <key>ProcessType</key>
  <string>Standard</string>
</dict>
</plist>
