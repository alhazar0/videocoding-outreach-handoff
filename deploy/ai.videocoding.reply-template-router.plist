<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.videocoding.reply-template-router</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/OPERATOR/.videocoding-outreach-runtime/.lead-collector-venv313/bin/python</string>
		<string>/Users/OPERATOR/.videocoding-outreach-runtime/scripts/reply_template_router.py</string>
		<string>--limit</string>
		<string>4</string>
		<string>--timeout</string>
		<string>240</string>
		<string>--codex</string>
		<string>/opt/homebrew/bin/codex</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/OPERATOR/.videocoding-outreach-runtime</string>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/OPERATOR/.videocoding-outreach-runtime/logs/reply-template-router.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/OPERATOR/.videocoding-outreach-runtime/logs/reply-template-router.error.log</string>
	<key>ProcessType</key>
	<string>Standard</string>
</dict>
</plist>
