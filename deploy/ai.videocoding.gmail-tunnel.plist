<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>ai.videocoding.gmail-tunnel</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/ssh</string>
		<string>-NT</string>
		<string>-p</string>
		<string>2222</string>
		<string>-i</string>
		<string>/Users/OPERATOR/.ssh/id_ed25519_phonefarm</string>
		<string>-o</string>
		<string>BatchMode=yes</string>
		<string>-o</string>
		<string>StrictHostKeyChecking=yes</string>
		<string>-o</string>
		<string>ExitOnForwardFailure=yes</string>
		<string>-o</string>
		<string>ConnectTimeout=10</string>
		<string>-o</string>
		<string>ServerAliveInterval=30</string>
		<string>-o</string>
		<string>ServerAliveCountMax=3</string>
		<string>-L</string>
		<string>127.0.0.1:1465:smtp.gmail.com:465</string>
		<string>root@REPLACE_WITH_TUNNEL_HOST</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/OPERATOR/.videocoding-outreach-runtime/logs/gmail-tunnel.error.log</string>
	<key>StandardOutPath</key>
	<string>/Users/OPERATOR/.videocoding-outreach-runtime/logs/gmail-tunnel.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
</dict>
</plist>
