<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.videocoding.outreach-health</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/OPERATOR/.videocoding-outreach-runtime/scripts/outreach_health_check.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/OPERATOR/.videocoding-outreach-runtime</string>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/OPERATOR/.videocoding-outreach-runtime/logs/outreach-health.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/OPERATOR/.videocoding-outreach-runtime/logs/outreach-health.error.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
